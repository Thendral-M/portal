<WixLocalization Culture="ja-jp" Language="1041" xmlns="http://wixtoolset.org/schemas/v4/wxl">
  <String Id="Caption" Value="[WixBundleName] セットアップ" />
  <String Id="Title" Value="[WixBundleName]" />
  <String Id="InstallHeader" Value="ようこそ" />
  <String Id="InstallMessage" Value="[WixBundleName]をコンピューターにインストールします。インストールをクリックすると続行します。閉じるをクリックすると終了します。" />
  <String Id="InstallVersion" Value="Version [WixBundleVersion]" />
  <String Id="ConfirmCancelMessage" Value="キャンセルしますか？" />
  <String Id="ExecuteUpgradeRelatedBundleMessage" Value="Previous version" />
  <String Id="HelpHeader" Value="Setup Help" />
  <String Id="HelpText" Value="/install | /repair | /uninstall | /layout [directory] - installs, repairs, uninstalls or creates a complete local copy of the bundle in directory. Install is the default. /passive | /quiet - displays minimal UI with no prompts or displays no UI and no prompts. By default UI and all prompts are displayed. /norestart - suppress any attempts to restart. By default UI will prompt before restart. /log log.txt - logs to a specific file. By default a log file is created in %TEMP%." />
  <String Id="HelpCloseButton" Value="&amp;Close" />
  <String Id="InstallLicenseLinkText" Value="[WixBundleName] &lt;a href=&quot;#&quot;&gt;ライセンス条項&lt;/a&gt;." />
  <String Id="InstallAcceptCheckbox" Value="ライセンス条件に同意する (&amp;A)" />
  <String Id="InstallOptionsButton" Value="オプション (&amp;O)" />
  <String Id="InstallInstallButton" Value="インストール (&amp;I)" />
  <String Id="InstallCloseButton" Value="閉じる (&amp;C)" />
  <String Id="OptionsHeader" Value="セットアップオプション" />
  <String Id="OptionsLocationLabel" Value="インストールする場所:" />
  <String Id="OptionsBrowseButton" Value="参照 (&amp;B)" />
  <String Id="OptionsOkButton" Value="OK (&amp;O)" />
  <String Id="OptionsCancelButton" Value="キャンセル (&amp;C)" />
  <String Id="ProgressHeader" Value="セットアップの進行状況" />
  <String Id="ProgressLabel" Value="処理:" />
  <String Id="OverallProgressPackageText" Value="初期化中..." />
  <String Id="ProgressCancelButton" Value="キャンセル (&amp;C)" />
  <String Id="ModifyHeader" Value="選択したアプリケーションを完全に削除します。" />
  <String Id="ModifyRepairButton" Value="修復 (&amp;R)" />
  <String Id="ModifyUninstallButton" Value="アンインストール (&amp;U)" />
  <String Id="ModifyCloseButton" Value="閉じる (&amp;C)" />
  <String Id="SuccessRepairHeader" Value="修復が正常に完了しました。" />
  <String Id="SuccessUninstallHeader" Value="アンインストールが正常に完了しました。" />
  <String Id="SuccessInstallHeader" Value="インストールが正常に完了しました。" /> 
  <String Id="SuccessHeader" Value="セットアップに成功" />	
  <String Id="SuccessLaunchButton" Value="&amp;Launch" />
  <String Id="SuccessRestartText" Value="ソフトウェアを使用する前に、コンピュータを再起動する必要があります。" />
  <String Id="SuccessRestartButton" Value="再起動 (&amp;R)" />
  <String Id="SuccessCloseButton" Value="閉じる (&amp;C)" />
