  <String Id="FilesInUseDontCloseRadioButton" Value="アプリケーションを閉じないで続行します。 (&amp;D) 再起動が必要になります。OK" />
  <String Id="FilesInUseOkButton" Value="OK (&amp;O)" />
  <String Id="FilesInUseCancelButton" Value="キャンセル (&amp;C)" />
  <String Id="ErrorFailNoActionReboot" Value="システムの再起動が必要なため、アクションは実行されませんでした。" />
